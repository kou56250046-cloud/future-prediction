{
  "_comment": "求人票の分類語彙。パターンは JavaScript の正規表現ソース（大小文字無視で適用）。フィールドの順序が固定でないパイプ区切り行を、位置ではなく内容で判定するために使う。",
  "_version": 2,

  "_roles": "職種。priority が大きいほど具体的で、複数当たったときに優先される。Machine Learning Engineer を swe ではなく ml にするための仕組み。語尾を緩めてあるのは実データが 'Engineers' 'Multiple Engineering Roles' のように複数形・動名詞で書かれるため",
  "roles": {
    "ml": {
      "priority": 90,
      "patterns": ["machine\\s*learning", "\\bml\\s*(engineer|scientist)", "\\bai\\s*(engineer|researcher|scientist)", "deep\\s*learning", "\\bnlp\\b", "computer\\s*vision", "research(er)?s?\\b", "\\bllm\\s*engineer", "applied\\s*scientist"]
    },
    "data": {
      "priority": 80,
      "patterns": ["data\\s*(engineer|scientist|analyst|architect)", "analytics\\s*engineer", "\\bbi\\s*(engineer|developer|analyst)", "business\\s*intelligence"]
    },
    "security": {
      "priority": 78,
      "patterns": ["security\\s*(engineer|architect|analyst|research)", "\\binfosec\\b", "appsec", "\\bciso\\b", "penetration\\s*test", "cryptograph"]
    },
    "infra": {
      "priority": 75,
      "patterns": ["\\bdevops\\b", "\\bsres?\\b", "site\\s*reliability", "infrastructure\\s*engineer", "platform\\s*engineer", "cloud\\s*(engineer|architect)", "systems?\\s*(engineer|administrator)", "\\bsysadmin", "network\\s*engineer"]
    },
    "qa": {
      "priority": 72,
      "patterns": ["\\bqa\\b", "quality\\s*(assurance|engineer)", "\\bsdet\\b", "test\\s*(engineer|automation)"]
    },
    "design": {
      "priority": 70,
      "patterns": ["\\b(ux|ui)\\b", "product\\s*design", "designers?\\b", "user\\s*(experience|research)", "\\bdesign\\s*(lead|manager|director)"]
    },
    "pm": {
      "priority": 68,
      "patterns": ["product\\s*manage", "\\bpms?\\b", "program\\s*manage", "project\\s*manage", "product\\s*owner", "\\btpm\\b", "technical\\s*program"]
    },
    "support": {
      "priority": 60,
      "patterns": ["support\\s*(engineer|specialist)", "customer\\s*(success|support)", "solutions?\\s*(engineer|architect)", "sales\\s*engineer", "developer\\s*(advocate|relations)", "\\bdevrel\\b", "technical\\s*writer"]
    },
    "swe": {
      "priority": 50,
      "patterns": ["software\\s*(engineer|developer|dev\\b)", "\\bswes?\\b", "\\bsdes?\\b", "(back|front)\\s*-?\\s*end", "full\\s*-?\\s*stack", "\\bengineer(s|ing)?\\b", "\\bdevelopers?\\b", "\\bprogrammers?\\b", "\\bcoders?\\b", "mobile\\s*(engineer|developer)", "web\\s*developer", "\\bcto\\b", "\\bhackers?\\b", "\\btech\\s*lead\\b"]
    }
  },

  "_seniority": "上から順に照合し、最初に当たったものを採る。junior を senior より先に見る",
  "seniority": [
    { "key": "junior", "patterns": ["\\bjuniors?\\b", "\\bjr\\.?\\b", "entry[\\s-]*level", "new\\s*grads?", "\\bgraduates?\\b", "\\binterns?(hip)?\\b", "apprentice", "\\bassociate\\s*(engineer|developer)", "early[\\s-]*career", "\\bl[12]\\b", "0-2\\s*years"] },
    { "key": "lead", "patterns": ["\\bleads?\\b", "\\bhead\\s*of\\b", "\\bdirector\\b", "\\bvp\\b", "\\bcto\\b", "\\bmanagers?\\b", "\\barchitects?\\b", "\\bprincipal\\b", "\\bdistinguished\\b", "founding\\s*(engineer|researcher)"] },
    { "key": "senior", "patterns": ["\\bseniors?\\b", "\\bsr\\.?\\b", "\\bstaff\\b", "\\bexperienced\\b", "\\bl[5-9]\\b", "[5-9]\\+?\\s*years", "\\d{2}\\+\\s*years"] },
    { "key": "mid", "patterns": ["\\bmid[\\s-]*(level|senior)?\\b", "\\bintermediate\\b", "\\bl[34]\\b", "[2-4]\\+?\\s*years"] }
  ],

  "_employment": "雇用形態。contract を fulltime より先に見る",
  "employment": [
    { "key": "intern", "patterns": ["\\binterns?(hip)?\\b", "\\bco-?op\\b"] },
    { "key": "contract", "patterns": ["\\bcontract(or|ing)?s?\\b", "\\bfreelanc", "\\bconsultan", "\\bc2c\\b", "\\b1099\\b", "\\bb2b\\b"] },
    { "key": "parttime", "patterns": ["part[\\s-]*time"] },
    { "key": "fulltime", "patterns": ["full[\\s-]*time", "\\bft\\b", "\\bpermanent\\b", "\\bperm\\b"] }
  ],

  "_remote": "hybrid を最優先。remote と onsite の両方が書かれていたら hybrid とみなす",
  "remote": {
    "hybrid": ["\\bhybrid\\b", "\\d\\s*days?\\s*(a|per)\\s*week\\s*in", "in[\\s-]*office\\s*\\d"],
    "remote": ["\\bremote(ly)?\\b", "\\bwfh\\b", "work\\s*from\\s*home", "\\bdistributed\\b", "anywhere"],
    "onsite": ["\\bon[\\s-]*site\\b", "\\bin[\\s-]*office\\b", "\\bin[\\s-]*person\\b", "\\bonsite\\b"]
  },

